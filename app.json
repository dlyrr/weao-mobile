{
  "expo": {
    "name": "WEAO",
    "slug": "weao-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "weao",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1a1a1a",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a1a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dlyrr.weao",
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch",
          "processing"
        ]
      },
      "buildNumber": "2"
    },
    "android": {
      "package": "com.dlyrr.weao",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a1a"
      },
      "permissions": [
        "NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK"
      ],
      "versionCode": 2
    },
    "plugins": [
      "./plugins/withReleaseSigning",
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-background-task",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#3bea57"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
